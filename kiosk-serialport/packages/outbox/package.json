{
  "name": "outbox",
  "main": "dist/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "cross-env NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning vite-node --watch ./index.ts",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning vite-node --watch ./index.ts",
    "build": "npm run build:prod",
    "build:prod": "cross-env NODE_ENV=production bun esbuild.config.mjs",
    "build:dev": "cross-env NODE_ENV=development bun esbuild.config.mjs",
    "build:watch": "cross-env NODE_ENV=development bun esbuild.config.mjs --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test src",
    "test:watch": "bun test src --watch"
  },
  "exports": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "version": "0.4.0"
}
