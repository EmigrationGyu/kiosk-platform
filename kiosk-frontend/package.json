{
  "name": "kiosk-frontend",
  "private": true,
  "version": "0.35.0-1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --mode development",
    "dev:prod": "bunx --bun vite --mode production",
    "dev:mock": "bunx --bun vite --mode mock",
    "build": "bun run typecheck:strict && bunx --bun vite build --mode production",
    "build:dev": "bun run typecheck:strict && bunx --bun vite build --mode development",
    "build:mock": "bun run typecheck:strict && bunx --bun vite build --mode mock",
    "typecheck": "tsgo -b",
    "typecheck:strict": "tsc -b",
    "build:bundle": "bunx --bun vite build --mode production",
    "build:bundle:dev": "bunx --bun vite build --mode development",
    "lint": "eslint .",
    "lint:compiler": "eslint --max-warnings=0 --ext .ts,.tsx src",
    "preview": "bunx --bun vite preview --mode development",
    "preview:prod": "bunx --bun vite preview --mode production",
    "code-gen": "graphql-codegen --config codegen.yml",
    "code-gen:check": "graphql-codegen --config codegen.yml && git diff --exit-code -- src/shared/types/gql.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@apollo/client": "4.0.9",
    "@daun_jung/korean-romanizer": "^1.0.1",
    "@dehoist/romanize-thai": "^1.0.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@sglkc/kuromoji": "^1.1.0",
    "@tolgee/format-icu": "^6.2.7",
    "@tolgee/react": "^6.2.7",
    "@types/greek-utils": "^1.2.2",
    "any-ascii": "^0.3.3",
    "apollo-upload-client": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "cyrillic-to-translit-js": "^3.2.1",
    "dayjs": "^1.11.19",
    "es-hangul": "^2.3.8",
    "graphql": "^16.12.0",
    "graphql-ws": "^6.0.7",
    "greek-utils": "^1.3.0",
    "hebrew-transliteration": "^2.9.1",
    "howler": "^2.2.4",
    "jsqr": "^1.4.0",
    "jwt-decode": "^4.0.0",
    "kuroshiro": "^1.2.0",
    "libphonenumber-js": "^1.12.36",
    "lottie-react": "^2.4.1",
    "metaphone3": "^1.0.1",
    "motion": "^12.23.24",
    "pretendard-jp": "^1.3.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.1",
    "swiper": "^12.1.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "transliteration": "^2.3.5",
    "kiosk-types": "workspace:*",
    "zod": "^4.1.11",
    "zod-validation-error": "^4.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@biomejs/biome": "2.4.10",
    "@eslint/js": "^9.36.0",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.0.2",
    "@graphql-codegen/typescript": "^5.0.4",
    "@graphql-codegen/typescript-operations": "^5.0.4",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/apollo-upload-client": "^18.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260526.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.4.35",
    "postcss-import": "^16.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.0.13",
    "vite-plugin-svgr": "^4.5.0"
  }
}
