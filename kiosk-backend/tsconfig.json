{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    "types": ["node", "bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "src/*": ["./src/*"],
      "@channel/Channel": ["./src/helpers/channel/impl/socket.ts"],
      "@storage/SecureStorage": ["./src/helpers/storage/impl/keytar.ts"],
      "@hardwareTransport/Transport": [
        "./src/hardwareTransport/impl/express-ipc.ts"
      ],
      "@bridge/Bridge": ["./src/bridge/impl/absent.ts"],
      "@platform/Platform": ["./src/platform/impl/node.ts"],
      "@processManager/Manager": ["./src/processManager/impl/node.ts"],
      "@serial/Port": ["./src/serialPortScanner/impl/real.ts"]
    }
  }
}
